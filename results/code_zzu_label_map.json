 "ambiguities": [
  {
   "key": "code-normal-versus-sinus",
   "what": "CODE carries no sinus-rhythm flag. Its 'normal_ecg' column is the automatic system's statement that the whole tracing is normal, which the Zenodo record describes as 'True if automatic annotation system say it is a normal ECG'. The rotation's NSR class is sinus rhythm on any tracing, abnormal or not.",
   "corpora": [
    "code15",
    "code_test"
   ],
   "decision": "NSR is refused on both CODE corpora, as on Shandong, and the class leaves their rows rather than being filled from 'normal_ecg' or from the absence of the other rhythm flags.",
   "why": "38.9% of CODE-15% exams are 'normal_ecg', against 83% sinus rhythm in PTB-XL; reading one as the other would change what the class means on one corpus, which the rotation could not tell from a change of hospital.",
   "evidence": "code15/record.json description of exams.csv; code-test data/README.md lists six annotations, none of them sinus rhythm",
   "refuses": [
    [
     "code15",
     "NSR"
    ],
    [
     "code_test",
     "NSR"
    ]
   ]
  },
  {
   "key": "code-test-short-exams",
   "what": "539 of the CODE test set's 827 exams hold 7.3 to 7.8 seconds of signal (2,934 or 3,134 samples at 400 Hz) and are padded to 4,096 with zeros, as the release's README says. The rotation's models read ten seconds and were trained on ten-second tracings.",
   "corpora": [
    "code_test"
   ],
   "decision": "The test set is kept whole: a short exam is cut to its signal and filled with zeros to ten seconds at the end. The ten-second exams are also reported on their own, so the effect of the fill can be read.",
   "why": "Dropping the short exams would keep 288 of 827 and 5 of the 13 atrial fibrillations; the cardiologist consensus is what makes the set worth reading, so the exams stay and the fill is named.",
   "evidence": "first and last non-zero sample of each exam in ecg_tracings.hdf5: 538 spans of 2,934 samples, 253 of 4,096, 35 of 4,000, 1 of 3,134",
   "refuses": []
  },
  {
   "key": "code-labels-are-reconciled",
   "what": "CODE-15%'s flags were not read by two cardiologists. Ribeiro et al. 2020 build them from the TNMG cardiologist's report, the Uni-G statements and Minnesota codes, with interval rules (RBBB and LBBB refused under a QRS of 115 ms, first-degree block under a PR of 190 ms) and a hand review of the exams the rules left open.",
   "corpora": [
    "code15"
   ],
   "decision": "The flags are used as published. Every CODE-15% row is labelled as reconciled report labels, and the test set's cardiologist consensus is kept as a separate corpus so the two kinds of label are never pooled.",
   "why": "The rotation compares thresholds across hospitals that label differently; naming how each corpus labels is how that difference stays readable, as MIMIC's machine labels are named in MIMIC.md.",
   "evidence": "Ribeiro et al., Nat Commun 11, 1760 (2020), Methods, 'Labeling training data'; Zenodo 4916206 description",
   "refuses": []
  },
  {
   "key": "zzu-no-sinus-rhythm-code",
   "what": "ZZU's 91 statements include sinus tachycardia, bradycardia and arrhythmia, 'Normal ECG' (AHA A1) and 'Otherwise normal ECG' (A2), but no statement of sinus rhythm itself (Supplementary Table 1 of Tan et al. 2025 lists none).",
   "corpora": [
    "zzu"
   ],
   "decision": "NSR is refused on ZZU, as on Shandong and CODE, rather than filled from 'Normal ECG' or from the absence of every other rhythm statement.",
   "why": "'Normal ECG' is a statement about the whole tracing and covers 1,906 of 14,190 records; reading it as sinus rhythm would put a far narrower class on the children than on the adults they are compared with.",
   "evidence": "zzu-pecg/ECGCode.csv has no sinus-rhythm row; Supplementary Table 1 of doi:10.1038/s41597-025-05225-z, rows A1, A2, C21 to C26",
   "refuses": [
    [
     "zzu",
     "NSR"
    ]
   ]
  },
  {
   "key": "zzu-iavb-without-aha-code",
   "what": "ZZU writes first-degree AV block two ways: 165 records carry the Chinese standard's 'First-degree AV block' (CHN H74), which has no AHA code, so the AHA column holds the statement's text; 12 carry AHA H82 'Prolonged PR interval', which Leinonen's table maps to first-degree block.",
   "corpora": [
    "zzu"
   ],
   "decision": "Both count as IAVB: the AHA base code 82 through Leinonen's table, and the statement text 'First-degree AV block' where the code is missing.",
   "why": "The rotation already unions the two names on every corpus (ambiguity 'iavb-lpr'); reading the code alone would keep 12 of 177 ZZU records and make the class mean something else on the children.",
   "evidence": "Supplementary Table 1 of doi:10.1038/s41597-025-05225-z: 'First-degree AV block, First-degree AV block, H74, 165' and 'Prolonged PR interval, H82, 12'",
   "refuses": []
  }
 ],
